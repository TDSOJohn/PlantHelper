__pycache__/

# The catalogues built with pfaf.org data. `data/plants.sqlite` — the
# Wikipedia-only build — stays in the repo; these two cannot, because pfaf.org
# grants no reuse licence. See "Three catalogues" in the README.
data/plants.full.sqlite
data/plants.export.sqlite
# The catalogue's thumbnails, from edibleplantdb.org's photos. Most are CC
# BY-NC and each needs its credit shown, so they travel like the builds above.
data/plants.thumbs.sqlite
